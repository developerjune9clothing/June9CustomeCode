{% comment %}
  Dual Video Split Section
  ---------------------------------------------------------
  Two-column section with a vertical video in EACH column.
  Each video can be wrapped in its own link (product/collection/page).

  Setup:
  1. Save this file as sections/dual-video-split.liquid
  2. Theme Editor > Add section > "Dual Video Split"
  3. Upload videos (Shopify-hosted) OR paste external MP4 URLs

  Performance: videos use preload="none" and only download when the
  section approaches the viewport. Playback pauses when scrolled away.
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign uid = section.id -%}

<section
  id="DualVideoSplit-{{ uid }}"
  class="dvs"
  style="
    --dvs-section-height: {{ s.section_height }}vh;
    --dvs-section-height-mobile: {{ s.section_height_mobile }}vh;
    --dvs-mt: {{ s.margin_top }}px;
    --dvs-mb: {{ s.margin_bottom }}px;
    --dvs-pt: {{ s.padding_top }}px;
    --dvs-pb: {{ s.padding_bottom }}px;
    --dvs-max-width: {{ s.content_max_width }}px;
    --dvs-gap: {{ s.column_gap }}px;
    --dvs-radius: {{ s.section_radius }}px;

    --dvs-v1-bg: {{ s.video1_bg_color }};
    --dvs-v1-fit: {{ s.video1_fit }};
    --dvs-v1-width: {{ s.video1_width }}%;
    --dvs-v1-radius: {{ s.video1_radius }}px;
    --dvs-v1-pad: {{ s.video1_column_padding }}px;
    --dvs-v1-overlay-color: {{ s.video1_overlay_color }};
    --dvs-v1-overlay-opacity: {{ s.video1_overlay_opacity }};

    --dvs-v2-bg: {{ s.video2_bg_color }};
    --dvs-v2-fit: {{ s.video2_fit }};
    --dvs-v2-width: {{ s.video2_width }}%;
    --dvs-v2-radius: {{ s.video2_radius }}px;
    --dvs-v2-pad: {{ s.video2_column_padding }}px;
    --dvs-v2-overlay-color: {{ s.video2_overlay_color }};
    --dvs-v2-overlay-opacity: {{ s.video2_overlay_opacity }};
  "
>
  <div class="dvs__inner">

    {%- comment -%} ---------- VIDEO COLUMN 1 ---------- {%- endcomment -%}
    <div class="dvs__col dvs__col--1">
      {%- if s.video1_link != blank -%}<a href="{{ s.video1_link }}" class="dvs__link" {% if s.video1_link_title != blank %}aria-label="{{ s.video1_link_title | escape }}"{% endif %}>{%- endif -%}
        <div class="dvs__media dvs__media--1">
          {%- if s.video1 != blank -%}
            {{ s.video1
              | video_tag:
                image_size: '1100x',
                autoplay: false,
                loop: s.video1_loop,
                muted: true,
                controls: s.video1_controls,
                playsinline: true,
                preload: 'none',
                class: 'dvs__video',
                data-dvs-lazy: 'shopify'
            }}
          {%- elsif s.video1_url != blank -%}
            <video
              class="dvs__video"
              data-dvs-lazy="external"
              data-dvs-src="{{ s.video1_url }}"
              muted
              {% if s.video1_loop %}loop{% endif %}
              {% if s.video1_controls %}controls{% endif %}
              playsinline
              preload="none"
              {% if s.video1_poster != blank %}poster="{{ s.video1_poster | image_url: width: 1100 }}" {% endif %}
            ></video>
          {%- else -%}
            <div class="dvs__placeholder">
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'dvs__placeholder-svg' }}
              <span>Add video 1 in the theme editor</span>
            </div>
          {%- endif -%}

          {%- if s.video1_overlay_opacity > 0 -%}
            <span class="dvs__overlay dvs__overlay--1" aria-hidden="true"></span>
          {%- endif -%}

          {%- if s.video1_caption != blank -%}
            <span class="dvs__caption dvs__caption--1">{{ s.video1_caption | escape }}</span>
          {%- endif -%}
        </div>
      {%- if s.video1_link != blank -%}</a>{%- endif -%}
    </div>

    {%- comment -%} ---------- VIDEO COLUMN 2 ---------- {%- endcomment -%}
    <div class="dvs__col dvs__col--2">
      {%- if s.video2_link != blank -%}<a href="{{ s.video2_link }}" class="dvs__link" {% if s.video2_link_title != blank %}aria-label="{{ s.video2_link_title | escape }}"{% endif %}>{%- endif -%}
        <div class="dvs__media dvs__media--2">
          {%- if s.video2 != blank -%}
            {{ s.video2
              | video_tag:
                image_size: '1100x',
                autoplay: false,
                loop: s.video2_loop,
                muted: true,
                controls: s.video2_controls,
                playsinline: true,
                preload: 'none',
                class: 'dvs__video',
                data-dvs-lazy: 'shopify'
            }}
          {%- elsif s.video2_url != blank -%}
            <video
              class="dvs__video"
              data-dvs-lazy="external"
              data-dvs-src="{{ s.video2_url }}"
              muted
              {% if s.video2_loop %}loop{% endif %}
              {% if s.video2_controls %}controls{% endif %}
              playsinline
              preload="none"
              {% if s.video2_poster != blank %}poster="{{ s.video2_poster | image_url: width: 1100 }}" {% endif %}
            ></video>
          {%- else -%}
            <div class="dvs__placeholder">
              {{ 'collection-apparel-2' | placeholder_svg_tag: 'dvs__placeholder-svg' }}
              <span>Add video 2 in the theme editor</span>
            </div>
          {%- endif -%}

          {%- if s.video2_overlay_opacity > 0 -%}
            <span class="dvs__overlay dvs__overlay--2" aria-hidden="true"></span>
          {%- endif -%}

          {%- if s.video2_caption != blank -%}
            <span class="dvs__caption dvs__caption--2">{{ s.video2_caption | escape }}</span>
          {%- endif -%}
        </div>
      {%- if s.video2_link != blank -%}</a>{%- endif -%}
    </div>

  </div>
</section>

<style>
  #DualVideoSplit-{{ uid }} {
    display: block;
    margin-top: var(--dvs-mt);
    margin-bottom: var(--dvs-mb);
    padding-top: var(--dvs-pt);
    padding-bottom: var(--dvs-pb);
    overflow: hidden;
    {% if s.section_radius > 0 %}border-radius: var(--dvs-radius);{% endif %}
  }

  #DualVideoSplit-{{ uid }} .dvs__inner {
    display: flex;
    width: 100%;
    {% if s.full_width == false %}
      max-width: var(--dvs-max-width);
      margin-left: auto;
      margin-right: auto;
    {% endif %}
    gap: var(--dvs-gap);
    height: var(--dvs-section-height);
    {% if s.desktop_order == 'reverse' %}flex-direction: row-reverse;{% else %}flex-direction: row;{% endif %}
  }

  #DualVideoSplit-{{ uid }} .dvs__col {
    flex: 1 1 50%;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #DualVideoSplit-{{ uid }} .dvs__col--1 { background: var(--dvs-v1-bg); padding: var(--dvs-v1-pad); overflow: hidden; }
  #DualVideoSplit-{{ uid }} .dvs__col--2 { background: var(--dvs-v2-bg); padding: var(--dvs-v2-pad); overflow: hidden; }

  #DualVideoSplit-{{ uid }} .dvs__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  #DualVideoSplit-{{ uid }} .dvs__media {
    position: relative;
    height: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #DualVideoSplit-{{ uid }} .dvs__media--1 { width: var(--dvs-v1-width); border-radius: var(--dvs-v1-radius); }
  #DualVideoSplit-{{ uid }} .dvs__media--2 { width: var(--dvs-v2-width); border-radius: var(--dvs-v2-radius); }

  #DualVideoSplit-{{ uid }} .dvs__video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
  }
  #DualVideoSplit-{{ uid }} .dvs__media--1 .dvs__video { object-fit: var(--dvs-v1-fit); border-radius: var(--dvs-v1-radius); }
  #DualVideoSplit-{{ uid }} .dvs__media--2 .dvs__video { object-fit: var(--dvs-v2-fit); border-radius: var(--dvs-v2-radius); }

  #DualVideoSplit-{{ uid }} .dvs__overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }
  #DualVideoSplit-{{ uid }} .dvs__overlay--1 {
    background: var(--dvs-v1-overlay-color);
    opacity: var(--dvs-v1-overlay-opacity);
    border-radius: var(--dvs-v1-radius);
  }
  #DualVideoSplit-{{ uid }} .dvs__overlay--2 {
    background: var(--dvs-v2-overlay-color);
    opacity: var(--dvs-v2-overlay-opacity);
    border-radius: var(--dvs-v2-radius);
  }

  /* Optional caption over the video */
  #DualVideoSplit-{{ uid }} .dvs__caption {
    position: absolute;
    left: 0;
    right: 0;
    {% if s.caption_position == 'top' %}top: {{ s.caption_offset }}px;
    {% elsif s.caption_position == 'center' %}top: 50%; transform: translateY(-50%);
    {% else %}bottom: {{ s.caption_offset }}px;{% endif %}
    text-align: center;
    padding: 0 16px;
    font-size: {{ s.caption_font_size }}px;
    font-weight: {{ s.caption_font_weight }};
    letter-spacing: {{ s.caption_letter_spacing }}px;
    color: {{ s.caption_color }};
    pointer-events: none;
    {% if s.caption_uppercase %}text-transform: uppercase;{% endif %}
    {% if s.caption_text_shadow %}text-shadow: 0 1px 6px rgba(0,0,0,0.45);{% endif %}
  }

  #DualVideoSplit-{{ uid }} .dvs__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: #f2f2f2;
    color: #777;
    font-size: 14px;
  }
  #DualVideoSplit-{{ uid }} .dvs__placeholder-svg {
    width: 120px;
    height: auto;
    opacity: 0.4;
  }

  /* Optional hover zoom */
  {% if s.hover_zoom %}
  @media (hover: hover) {
    #DualVideoSplit-{{ uid }} .dvs__video {
      transition: transform 0.5s ease;
    }
    #DualVideoSplit-{{ uid }} .dvs__link:hover .dvs__video {
      transform: scale(1.04);
    }
  }
  {% endif %}

  /* ---------- MOBILE ---------- */
  @media screen and (max-width: 749px) {
    #DualVideoSplit-{{ uid }} .dvs__inner {
      {% if s.mobile_layout == 'side-by-side' %}
        flex-direction: {% if s.mobile_order == 'reverse' %}row-reverse{% else %}row{% endif %};
        height: {{ s.video_height_mobile }}vh;
      {% else %}
        flex-direction: {% if s.mobile_order == 'reverse' %}column-reverse{% else %}column{% endif %};
        height: auto;
        min-height: var(--dvs-section-height-mobile);
      {% endif %}
      gap: {{ s.column_gap_mobile }}px;
    }
    #DualVideoSplit-{{ uid }} .dvs__col {
      {% if s.mobile_layout == 'side-by-side' %}
        flex: 1 1 50%;
        height: 100%;
      {% else %}
        flex: 0 0 auto;
        width: 100%;
        height: {{ s.video_height_mobile }}vh;
      {% endif %}
    }
    #DualVideoSplit-{{ uid }} .dvs__col--1 { padding: {{ s.video1_column_padding_mobile }}px; }
    #DualVideoSplit-{{ uid }} .dvs__col--2 { padding: {{ s.video2_column_padding_mobile }}px; }

    #DualVideoSplit-{{ uid }} .dvs__media--1 { width: {{ s.video1_width_mobile }}%; }
    #DualVideoSplit-{{ uid }} .dvs__media--2 { width: {{ s.video2_width_mobile }}%; }

    #DualVideoSplit-{{ uid }} .dvs__caption { font-size: {{ s.caption_font_size_mobile }}px; }

    #DualVideoSplit-{{ uid }} {
      margin-top: {{ s.margin_top_mobile }}px;
      margin-bottom: {{ s.margin_bottom_mobile }}px;
      padding-top: {{ s.padding_top_mobile }}px;
      padding-bottom: {{ s.padding_bottom_mobile }}px;
    }
  }
</style>

<script>
(function () {
  var section = document.getElementById('DualVideoSplit-{{ uid }}');
  if (!section) return;

  var videos = section.querySelectorAll('video[data-dvs-lazy]');
  if (!videos.length) return;

  var wantsAutoplay = {% if s.autoplay %}true{% else %}false{% endif %};
  var loadedFlags = [];

  function loadVideo(video, idx) {
    if (loadedFlags[idx]) return;
    loadedFlags[idx] = true;

    if (video.getAttribute('data-dvs-lazy') === 'external') {
      var url = video.getAttribute('data-dvs-src');
      if (url && !video.querySelector('source')) {
        var source = document.createElement('source');
        source.src = url;
        source.type = 'video/mp4';
        video.appendChild(source);
      }
    }
    video.preload = 'auto';
    video.load();
  }

  function playIfWanted(video) {
    if (!wantsAutoplay) return;
    var p = video.play();
    if (p && typeof p.catch === 'function') { p.catch(function () {}); }
  }

  function loadAll() {
    Array.prototype.forEach.call(videos, function (v, i) { loadVideo(v, i); });
  }

  if ('IntersectionObserver' in window) {
    // Stage 1: begin downloading just before the section scrolls into view
    var preloadObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          loadAll();
          preloadObserver.disconnect();
        }
      });
    }, { rootMargin: '400px 0px' });
    preloadObserver.observe(section);

    // Stage 2: play only while visible; pause when scrolled away
    var playObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          loadAll();
          Array.prototype.forEach.call(videos, playIfWanted);
        } else {
          Array.prototype.forEach.call(videos, function (v) {
            if (!v.paused) v.pause();
          });
        }
      });
    }, { threshold: 0.25 });
    playObserver.observe(section);
  } else {
    loadAll();
    Array.prototype.forEach.call(videos, playIfWanted);
  }
})();
</script>

{% schema %}
{
  "name": "Dual Video Split",
  "tag": "section",
  "class": "section-dual-video-split",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "desktop_order", "label": "Desktop column order",
      "options": [
        { "value": "normal", "label": "Video 1 left / Video 2 right" },
        { "value": "reverse", "label": "Video 2 left / Video 1 right" }
      ],
      "default": "normal"
    },
    {
      "type": "select", "id": "mobile_layout", "label": "Mobile layout",
      "options": [
        { "value": "stacked", "label": "Stacked (one above the other)" },
        { "value": "side-by-side", "label": "Side by side (keep 2 columns)" }
      ],
      "default": "stacked"
    },
    {
      "type": "select", "id": "mobile_order", "label": "Mobile order",
      "options": [
        { "value": "normal", "label": "Video 1 first" },
        { "value": "reverse", "label": "Video 2 first" }
      ],
      "default": "normal"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full screen width", "default": true },
    { "type": "range", "id": "content_max_width", "label": "Max content width (if not full width)", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1400 },
    { "type": "range", "id": "section_height", "label": "Desktop section height", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 70 },
    { "type": "range", "id": "section_height_mobile", "label": "Mobile min height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 0 },
    { "type": "range", "id": "video_height_mobile", "label": "Mobile video height (each)", "min": 20, "max": 90, "step": 5, "unit": "vh", "default": 50 },
    { "type": "range", "id": "column_gap", "label": "Desktop gap between columns", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "column_gap_mobile", "label": "Mobile gap between columns", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "section_radius", "label": "Section corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section Spacing — Desktop" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section Spacing — Mobile" },
    { "type": "range", "id": "margin_top_mobile", "label": "Margin top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Margin bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Playback (both videos)" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay when in view (muted)", "default": true },
    { "type": "checkbox", "id": "hover_zoom", "label": "Zoom video slightly on hover", "default": false },

    { "type": "header", "content": "Video 1" },
    { "type": "video", "id": "video1", "label": "Video 1 (upload to Shopify)" },
    { "type": "text", "id": "video1_url", "label": "OR external MP4 URL", "info": "Only used if no video is uploaded above." },
    { "type": "image_picker", "id": "video1_poster", "label": "Poster image (for external URL)" },
    { "type": "url", "id": "video1_link", "label": "Link (product / collection / page)" },
    { "type": "text", "id": "video1_link_title", "label": "Link accessibility label", "info": "Describes the link for screen readers, e.g. 'Shop polka dot dresses'." },
    { "type": "text", "id": "video1_caption", "label": "Caption over video (optional)" },
    {
      "type": "select", "id": "video1_fit", "label": "Video fit",
      "options": [
        { "value": "contain", "label": "Contain (show full video, no crop)" },
        { "value": "cover", "label": "Cover (fill column, may crop)" }
      ],
      "default": "contain"
    },
    { "type": "range", "id": "video1_width", "label": "Desktop width", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video1_width_mobile", "label": "Mobile width", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video1_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "video1_column_padding", "label": "Desktop column padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "video1_column_padding_mobile", "label": "Mobile column padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "video1_bg_color", "label": "Column background", "default": "#f5f5f5" },
    { "type": "color", "id": "video1_overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "video1_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 0.9, "step": 0.1, "default": 0, "info": "Set to 0 for no overlay." },
    { "type": "checkbox", "id": "video1_loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "video1_controls", "label": "Show controls", "default": false },

    { "type": "header", "content": "Video 2" },
    { "type": "video", "id": "video2", "label": "Video 2 (upload to Shopify)" },
    { "type": "text", "id": "video2_url", "label": "OR external MP4 URL", "info": "Only used if no video is uploaded above." },
    { "type": "image_picker", "id": "video2_poster", "label": "Poster image (for external URL)" },
    { "type": "url", "id": "video2_link", "label": "Link (product / collection / page)" },
    { "type": "text", "id": "video2_link_title", "label": "Link accessibility label", "info": "Describes the link for screen readers, e.g. 'Shop floral dresses'." },
    { "type": "text", "id": "video2_caption", "label": "Caption over video (optional)" },
    {
      "type": "select", "id": "video2_fit", "label": "Video fit",
      "options": [
        { "value": "contain", "label": "Contain (show full video, no crop)" },
        { "value": "cover", "label": "Cover (fill column, may crop)" }
      ],
      "default": "contain"
    },
    { "type": "range", "id": "video2_width", "label": "Desktop width", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video2_width_mobile", "label": "Mobile width", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video2_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "video2_column_padding", "label": "Desktop column padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "video2_column_padding_mobile", "label": "Mobile column padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "video2_bg_color", "label": "Column background", "default": "#f5f5f5" },
    { "type": "color", "id": "video2_overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "video2_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 0.9, "step": 0.1, "default": 0, "info": "Set to 0 for no overlay." },
    { "type": "checkbox", "id": "video2_loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "video2_controls", "label": "Show controls", "default": false },

    { "type": "header", "content": "Caption Styling (both videos)" },
    { "type": "color", "id": "caption_color", "label": "Caption color", "default": "#ffffff" },
    { "type": "range", "id": "caption_font_size", "label": "Desktop font size", "min": 10, "max": 48, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "caption_font_size_mobile", "label": "Mobile font size", "min": 9, "max": 32, "step": 1, "unit": "px", "default": 16 },
    {
      "type": "select", "id": "caption_font_weight", "label": "Font weight",
      "options": [
