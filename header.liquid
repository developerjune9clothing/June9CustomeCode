{%- liquid
  assign main_menu = linklists[section.settings.main_menu_link_list]
  assign toolbar_menu = linklists[section.settings.toolbar_menu]

  assign logo_alignment = 'left'
  if section.settings.main_menu_alignment == 'center-left' or section.settings.main_menu_alignment == 'center-split' or section.settings.main_menu_alignment == 'center' or section.settings.main_menu_alignment == 'center-drawer'
    assign logo_alignment = 'center'
  endif

  assign dropdown_alignment = 'left'
  if section.settings.main_menu_alignment == 'left-center' or section.settings.main_menu_alignment == 'center-split' or section.settings.main_menu_alignment == 'center'
    assign dropdown_alignment = 'center'
  endif

  assign template_name = template | replace: '.', ' ' | truncatewords: 2, '' | handle

  assign sticky_header = false
  if section.settings.header_style == 'sticky'
    assign sticky_header = true
  endif
  assign overlay_header = false
  if template_name == 'index' and section.settings.sticky_index
    assign overlay_header = true
  endif
  if template_name contains 'collection' and collection.image and section.settings.sticky_collection
    assign overlay_header = true
  endif
-%}

{%- render 'drawer-menu',
  section: section,
  main_menu: main_menu,
  toolbar_menu: toolbar_menu,
  logo_alignment: logo_alignment
-%}
{%- render 'cart-drawer' -%}

{% capture account_icon %}
  {%- if section.settings.mobile_show_account -%}
    <a href="{% if section.settings.account_link != blank %}{{ section.settings.account_link }}{% else %}{{ routes.account_url }}{% endif %}" class="site-nav__link site-nav__link--icon mobile-extra-icon">
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-user" viewBox="0 0 64 64"><path d="M35 39.84v-2.53c3.3-1.91 6-6.66 6-11.41 0-7.3-3-13.84-9-13.84s-9 6.54-9 13.84c0 4.75 2.7 9.5 6 11.41v2.53c-10.18.85-18 6-18 12.16h42c0-6.19-7.82-11.31-18-12.16z"/></svg>
    </a>
  {%- endif -%}
{% endcapture %}

{% capture wishlist_icon %}
  {%- if section.settings.mobile_show_wishlist -%}
    <a href="{% if section.settings.wishlist_link != blank %}{{ section.settings.wishlist_link }}{% else %}#wishlist{% endif %}" class="site-nav__link site-nav__link--icon mobile-extra-icon wishlist-hero-custom-icon">
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-heart" viewBox="0 0 64 64"><path d="M51.27 15.05a13 13 0 0 0-18.44 0l-1.33 1.34-1.33-1.34a13 13 0 0 0-18.44 18.44l19.77 19.77 19.77-19.77a13 13 0 0 0 0-18.44z"/></svg>
    </a>
  {%- endif -%}
{% endcapture %}

{% capture desktop_wishlist_icon %}
  {%- if section.settings.desktop_show_wishlist -%}
    <div class="site-nav small--hide" style="margin: 0; display: flex; align-items: center;">
      <a href="{% if section.settings.wishlist_link != blank %}{{ section.settings.wishlist_link }}{% else %}#wishlist{% endif %}" class="site-nav__link site-nav__link--icon wishlist-hero-custom-icon">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-heart" viewBox="0 0 64 64"><path d="M51.27 15.05a13 13 0 0 0-18.44 0l-1.33 1.34-1.33-1.34a13 13 0 0 0-18.44 18.44l19.77 19.77 19.77-19.77a13 13 0 0 0 0-18.44z"/></svg>
      </a>
    </div>
  {%- endif -%}
{% endcapture %}

<style>
  .site-nav__link,
  .site-nav__dropdown-link:not(.site-nav__dropdown-link--top-level) {
    font-size: {{ settings.type_navigation_size }}px;
  }
  {% if settings.type_navigation_capitalize %}
    .site-nav__link, .mobile-nav__link--top-level {
      text-transform: uppercase;
      letter-spacing: 0.2em;
    }
    .mobile-nav__link--top-level {
      font-size: 1.1em;
    }
  {% endif %}

  {% if mainmenu.length > 6 %}
    .site-nav__link {
      padding-left: 10px;
      padding-right: 10px;
    }
  {% endif %}

  {% unless section.settings.mega_menu_images %}
    .megamenu__collection-image {
      display: none;
    }
  {% endunless %}

  {%- if settings.color_header == settings.color_body_bg or settings.color_body_bg contains settings.color_header -%}
    .site-header {
      box-shadow: 0 0 1px rgba(0,0,0,0.2);
    }

    .toolbar + .header-sticky-wrapper .site-header {
      border-top: 0;
    }
  {%- endif -%}

  /* --- DESKTOP ALIGNMENT FIX --- */
  @media only screen and (min-width: 769px) {
    .mobile-extra-icon {
      display: none !important;
    }
    .header-item--icons {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
    }
    .header-item--icons > * {
      display: flex;
      align-items: center;
    }
  }

  /* --- NEW MOBILE LAYOUT CONTROLS --- */
  @media only screen and (max-width: 768px) {
    .site-nav__link--icon svg.icon,
    .mobile-extra-icon svg.icon {
      width: {{ section.settings.mobile_icon_size }}px !important;
      height: {{ section.settings.mobile_icon_size }}px !important;
    }
    .header-item--logo img {
      max-width: {{ section.settings.mobile_logo_size }}px !important;
    }
    {% if section.settings.mobile_menu_alignment == 'left' %}
      #NavDrawer {
        left: 0 !important;
        right: auto !important;
        transform: translateX(-100%) !important;
      }
    {% else %}
      #NavDrawer {
        left: auto !important;
        right: 0 !important;
        transform: translateX(100%) !important;
      }
    {% endif %}

    .js-drawer-open #NavDrawer,
    .js-drawer-open-nav #NavDrawer,
    #NavDrawer.drawer--is-open,
    #NavDrawer[aria-hidden="false"] {
      transform: translateX(0) !important;
    }
    .header-layout {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      width: 100% !important;
    }
    .header-item--mobile-left,
    .header-item--logo,
    .header-item--icons {
      flex: 1 1 0% !important;
      width: 33.33% !important;
    }
    .header-item--mobile-left { order: 1; display: flex !important; justify-content: flex-start !important; align-items: center !important; }
    .header-item--logo { order: 2; display: flex !important; justify-content: center !important; align-items: center !important; text-align: center; }
    .header-item--icons { order: 3; display: flex !important; justify-content: flex-end !important; align-items: center !important; }
    .header-item--icons .js-drawer-open-nav { display: none !important; }
    .site-nav__link--icon { padding: 5px 8px !important; }
    .site-nav { margin: 0 !important; }

    {% if section.settings.mobile_logo_alignment == 'left' %}
      .header-item--logo { order: 1; justify-content: flex-start !important; }
      .header-item--mobile-left { order: 2; justify-content: flex-end !important; }
      .header-item--icons { order: 3; }
    {% elsif section.settings.mobile_logo_alignment == 'right' %}
      .header-item--mobile-left { order: 1; }
      .header-item--icons { order: 2; justify-content: center !important; }
      .header-item--logo { order: 3; justify-content: flex-end !important; }
    {% endif %}

    {% if section.settings.mobile_menu_alignment == 'right' %}
       {% if section.settings.mobile_logo_alignment == 'center' %}
          .header-item--logo { order: 1; justify-content: flex-start !important; }
          .header-item--icons { order: 2; justify-content: center !important;}
          .header-item--mobile-left { order: 3; justify-content: flex-end !important; }
       {% endif %}
    {% endif %}
  }
</style>

<div data-section-id="{{ section.id }}" data-section-type="header">
  {%- unless overlay_header -%}
    {%- if section.settings.show_locale_selector
      or section.settings.show_currency_selector
      or section.settings.toolbar_social
      or section.settings.toolbar_menu != blank
    -%}
      {%- render 'toolbar', section: section, toolbar_menu: toolbar_menu, overlay_header: overlay_header -%}
    {%- endif -%}
  {%- endunless -%}

  <div class="header-sticky-wrapper">
    <div id="HeaderWrapper" class="header-wrapper{% if overlay_header %} header-wrapper--sticky is-light{% endif %}">
      {%- if overlay_header -%}
        {%- if section.settings.show_locale_selector
          or section.settings.show_currency_selector
          or section.settings.toolbar_social
          or section.settings.toolbar_menu != blank
        -%}
          {%- render 'toolbar', section: section, toolbar_menu: toolbar_menu, overlay_header: overlay_header -%}
        {%- endif -%}
      {%- endif -%}
      <header
        id="SiteHeader"
        class="site-header{% if settings.type_navigation_style == 'heading' %} site-header--heading-style{% endif %}"
        data-sticky="{{ sticky_header }}"
        data-overlay="{{ overlay_header }}"
      >
        <div class="page-width">
          <div class="header-layout header-layout--{{ section.settings.main_menu_alignment }}" data-logo-align="{{ logo_alignment }}">
            
            <div class="header-item header-item--mobile-left medium-up--hide">
               <div class="site-nav">
                 <button type="button" class="site-nav__link site-nav__link--icon js-drawer-open-nav" aria-controls="NavDrawer">
                   <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-hamburger" viewBox="0 0 64 64"><path d="M7 15h51M7 32h43M7 49h51"/></svg>
                   <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
                 </button>
               </div>
               {% if section.settings.wishlist_placement == 'left' %}
                 {{ wishlist_icon }}
               {% endif %}
               {% if section.settings.account_placement == 'left' %}
                 {{ account_icon }}
               {% endif %}
            </div>

            {%- if logo_alignment == 'left' -%}
              <div class="header-item header-item--logo">
                {%- render 'header-logo-block', section: section -%}
              </div>
            {%- endif -%}

            {%- if logo_alignment == 'left' and section.settings.main_menu_alignment != 'left-drawer' -%}
              <div class="header-item header-item--navigation{% if section.settings.main_menu_alignment == 'left-center' %} text-center{% endif %} small--hide" {% unless disable_aria %}role="navigation" aria-label="Primary"{% endunless %}>
                {%- render 'header-desktop-nav', main_menu: main_menu, dropdown_alignment: dropdown_alignment, hover_menu: section.settings.hover_menu -%}
              </div>
            {%- endif -%}

            {%- if logo_alignment == 'center' -%}
              <div class="header-item header-item--left header-item--navigation small--hide">
                {%- if section.settings.main_menu_alignment == 'center' or section.settings.main_menu_alignment == 'center-split' -%}
                  {%- if settings.search_enable -%}
                    <div class="site-nav small--hide">
                      <a href="{{ routes.search_url }}" class="site-nav__link site-nav__link--icon js-search-header">
                        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" viewBox="0 0 64 64"><path d="M47.16 28.58A18.58 18.58 0 1 1 28.58 10a18.58 18.58 0 0 1 18.58 18.58ZM54 54 41.94 42"/></svg>
                        <span class="icon__fallback-text">{{ 'general.search.title' | t }}</span>
                      </a>
                    </div>
                  {%- endif -%}
                {%- endif -%}

                {%- if section.settings.main_menu_alignment == 'center-left' -%}
                  {%- render 'header-desktop-nav', main_menu: main_menu, dropdown_alignment: dropdown_alignment, hover_menu: section.settings.hover_menu -%}
                {%- endif -%}

                <div class="site-nav medium-up--hide">
                  <button type="button" class="site-nav__link site-nav__link--icon js-drawer-open-nav" aria-controls="NavDrawer">
                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-hamburger" viewBox="0 0 64 64"><path d="M7 15h51M7 32h43M7 49h51"/></svg>
                    <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
                  </button>
                </div>
              </div>

              {%- if section.settings.main_menu_alignment == 'center-split' -%}
                {%- render 'header-split-nav', main_menu: main_menu, section: section, dropdown_alignment: dropdown_alignment, hover_menu: section.settings.hover_menu -%}
              {%- endif -%}

              {%- if section.settings.main_menu_alignment != 'center-split' -%}
                <div class="header-item header-item--logo">
                  {%- render 'header-logo-block', section: section -%}
                </div>
              {%- endif -%}
            {%- endif -%}

            <div class="header-item header-item--icons">
              <div class="mobile-extra-icons-right medium-up--hide" style="display:flex; align-items:center;">
                {% if section.settings.wishlist_placement == 'right' %}
                  {{ wishlist_icon }}
                {% endif %}
                {% if section.settings.account_placement == 'right' %}
                  {{ account_icon }}
                {% endif %}
              </div>
              
              {% if section.settings.desktop_wishlist_placement == 'left' %}
                {{ desktop_wishlist_icon }}
              {% endif %}
              
              {%- render 'header-icons', section: section -%}
              
              {% if section.settings.desktop_wishlist_placement == 'right' %}
                {{ desktop_wishlist_icon }}
              {% endif %}
            </div>

          </div>

          {%- if section.settings.main_menu_alignment == 'center' -%}
            <div class="text-center">
              {%- render 'header-desktop-nav', main_menu: main_menu, dropdown_alignment: dropdown_alignment, hover_menu: section.settings.hover_menu -%}
            </div>
          {%- endif -%}
        </div>
        <div class="site-header__search-container">
          <div class="site-header__search">
            <div class="page-width">
              {% render 'predictive-search', context: 'header' %}
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>
</div>

{%- if section.settings.enable_menu_anim and section.settings.menu_anim_target != blank -%}
  <style>
    /* Ensure the link container allows absolute positioning of the badge */
    .custom-animated-link {
      display: inline-flex !important; 
      align-items: center;
      position: relative;
    }

    /* --- MULTI-COLOR SHIMMER ENGINE --- */
    {% assign colors = section.settings.menu_anim_colors | split: ',' %}
    {% capture gradient_stops %}
      {% for color in colors %}
        {{ color | strip }}{% unless forloop.last %}, {% endunless %}
      {% endfor %}
      , {{ colors.first | strip }}
    {% endcapture %}

    .anim-shimmer {
      background: linear-gradient(90deg, {{ gradient_stops }});
      background-size: 200% auto;
      color: transparent !important;
      -webkit-background-clip: text;
      background-clip: text;
      animation: navShimmer {{ section.settings.menu_anim_speed }}s linear infinite;
    }
    @keyframes navShimmer {
      to { background-position: 200% center; }
    }

    /* --- SUPERSCRIPT BADGE (BULLETPROOFED) --- */
    .site-header .custom-animated-link .menu-superscript,
    .menu-superscript {
      font-family: 'Poppins', sans-serif !important;
      font-size: {{ section.settings.menu_sup_font_size }}px !important;
      
      /* Base positioning */
      position: absolute !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      
      /* Bulletproof Colors */
      background: {{ section.settings.menu_sup_bg }} !important;
      color: {{ section.settings.menu_sup_color }} !important;
      -webkit-text-fill-color: {{ section.settings.menu_sup_color }} !important;
      border: {{ section.settings.menu_sup_border_width }}px solid {{ section.settings.menu_sup_border_color }} !important;
      
      padding: 2px 4px !important;
      border-radius: {{ section.settings.menu_sup_radius }}px !important;
      
      line-height: 1.2 !important;
      letter-spacing: normal !important;
      text-transform: none !important;
      font-weight: 600 !important;
      white-space: nowrap !important;
      z-index: 10 !important;
      
      /* Overrides underlying gradient text effect */
      -webkit-background-clip: initial !important;
      background-clip: padding-box !important;
      animation: none !important;
    }

    /* Desktop Positioning */
    @media only screen and (min-width: 769px) {
      .site-header .custom-animated-link .menu-superscript,
      .menu-superscript {
        top: {{ section.settings.menu_sup_offset_top }}px !important;
        left: {{ section.settings.menu_sup_offset_left }}px !important;
      }
    }

    /* Mobile Positioning */
    @media only screen and (max-width: 768px) {
      .site-header .custom-animated-link .menu-superscript,
      .menu-superscript {
        top: {{ section.settings.mobile_menu_sup_offset_top }}px !important;
        left: {{ section.settings.mobile_menu_sup_offset_left }}px !important;
      }
    }
  </style>

  <script>
    function injectMenuAnimation() {
      // 1. Target Data
      var targetText = "{{ section.settings.menu_anim_target | downcase | escape }}".trim();
      var menuLinks = document.querySelectorAll('.site-nav__link, .site-nav__dropdown-link, .mobile-nav__link');
      
      // Clean up existing badges to prevent duplicates in Theme Editor
      document.querySelectorAll('.menu-superscript').forEach(el => el.remove());

      // 2. Setup Superscript Data
      var iconStyle = "{{ section.settings.menu_sup_icon }}";
      var iconHtml = '';
      if (iconStyle === 'star') iconHtml = '⭐ ';
      else if (iconStyle === 'heart') iconHtml = '❤️';
      else if (iconStyle === 'balloon') iconHtml = '🎈 ';
      else if (iconStyle === 'fire') iconHtml = '🔥 ';
      else if (iconStyle === 'sparkle') iconHtml = '✨ ';

      var supText = "{{ section.settings.menu_sup_text | escape }}".trim();

      // 3. Inject Effects
      menuLinks.forEach(function(link) {
        var linkText = link.innerText.trim().toLowerCase();
        
        if(linkText === targetText) {
          // Add core Shimmer class
          link.classList.add('custom-animated-link', 'anim-shimmer');

          // Append absolute positioned badge if text or icon exists
          if (supText !== '' || iconHtml !== '') {
            var supNode = document.createElement('span');
            supNode.className = 'menu-superscript';
            supNode.innerHTML = iconHtml + supText;
            link.appendChild(supNode);
          }
        }
      });
    }

    // Run on page load
    document.addEventListener('DOMContentLoaded', injectMenuAnimation);
    // Run when Theme Editor is updated
    document.addEventListener('shopify:section:load', injectMenuAnimation);
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu_link_list",
      "label": "t:sections.header.settings.main_menu_link_list.label",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "hover_menu",
      "label": "t:sections.header.settings.hover_menu.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mega_menu_images",
      "label": "t:sections.header.settings.mega_menu_images.label",
      "default": true,
      "info": "t:sections.header.settings.mega_menu_images.info"
    },
    {
      "type": "select",
      "id": "main_menu_alignment",
      "label": "t:sections.header.settings.main_menu_alignment.label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:sections.header.settings.main_menu_alignment.options.left.label" },
        { "value": "left-center", "label": "t:sections.header.settings.main_menu_alignment.options.left-center.label" },
        { "value": "left-drawer", "label": "t:sections.header.settings.main_menu_alignment.options.left-drawer.label" },
        { "value": "center-left", "label": "t:sections.header.settings.main_menu_alignment.options.center-left.label" },
        { "value": "center-split", "label": "t:sections.header.settings.main_menu_alignment.options.center-split.label" },
        { "value": "center", "label": "t:sections.header.settings.main_menu_alignment.options.center.label" },
        { "value": "center-drawer", "label": "t:sections.header.settings.main_menu_alignment.options.center-drawer.label" }
      ]
    },
    {
      "type": "header",
      "content": "🔥 Highlighted Menu Text"
    },
    {
      "type": "checkbox",
      "id": "enable_menu_anim",
      "label": "Enable Custom Menu Styling",
      "default": true
    },
    {
      "type": "text",
      "id": "menu_anim_target",
      "label": "Target Menu Item (Text)",
      "default": "Polka Dot Edition",
      "info": "Type the exact name of the menu item you want to highlight."
    },
    {
      "type": "text",
      "id": "menu_anim_colors",
      "label": "Multi-Color Shimmer Hex Codes",
      "default": "#FF2A6D, #05D9E8, #F8E71C",
      "info": "List the colors you want to cycle through, separated by commas."
    },
    {
      "type": "range",
      "id": "menu_anim_speed",
      "label": "Animation Speed (Seconds)",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "info": "Lower is faster, higher is slower."
    },
    {
      "type": "header",
      "content": "✨ Menu Superscript Badge"
    },
    {
      "type": "text",
      "id": "menu_sup_text",
      "label": "Superscript Text",
      "default": "Charmé",
      "info": "Leave blank to show no text."
    },
    {
      "type": "select",
      "id": "menu_sup_icon",
      "label": "Superscript Icon",
      "default": "star",
      "options": [
        { "value": "none", "label": "No Icon" },
        { "value": "star", "label": "⭐ Star" },
        { "value": "heart", "label": "❤️ Heart" },
        { "value": "balloon", "label": "🎈 Balloon" },
        { "value": "fire", "label": "🔥 Fire" },
        { "value": "sparkle", "label": "✨ Sparkle" }
      ]
    },
    {
      "type": "range",
      "id": "menu_sup_font_size",
      "label": "Badge Font Size",
      "default": 11,
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "menu_sup_color",
      "label": "Badge Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "menu_sup_bg",
      "label": "Badge Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "menu_sup_border_color",
      "label": "Badge Border Color",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "menu_sup_border_width",
      "label": "Badge Border Width",
      "default": 1,
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "menu_sup_radius",
      "label": "Badge Border Radius",
      "default": 12,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "🖥️ Desktop Badge Positioning"
    },
    {
      "type": "range",
      "id": "menu_sup_offset_top",
      "label": "Vertical Adjust (Top/Bottom)",
      "default": -15,
      "min": -60,
      "max": 40,
      "step": 1,
      "unit": "px",
      "info": "Use negative numbers to move the badge UP."
    },
    {
      "type": "range",
      "id": "menu_sup_offset_left",
      "label": "Horizontal Adjust (Left/Right)",
      "default": 100,
      "min": -50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "info": "Increase value to move the badge further RIGHT."
    },
    {
      "type": "header",
      "content": "📱 Mobile Badge Positioning"
    },
    {
      "type": "range",
      "id": "mobile_menu_sup_offset_top",
      "label": "Mobile Vertical Adjust",
      "default": -10,
      "min": -60,
      "max": 40,
