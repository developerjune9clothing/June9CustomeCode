{% comment %}
  Video + Text Split Section
  ---------------------------------------------------------
  Full-width two-column section: vertical video on one side,
  text content (subheading, heading, paragraph, CTA) on the other.

  Setup:
  1. Save this file as sections/video-text-split.liquid
  2. Theme Editor > Add section > "Video + Text Split"
  3. Upload a video (Shopify-hosted) OR paste an external MP4 URL

  All layout, colours, fonts, spacing are editable in the Theme Editor.
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign uid = section.id -%}

{%- comment -%}
  Fonts are loaded NON-BLOCKING (media="print" + onload swap) so they never
  delay first paint. The "vts-font-loaded" guard prevents duplicate requests
  if this section is used more than once on a page.
{%- endcomment -%}
{%- if s.font_family != 'theme' -%}
  {%- assign font_query = s.font_family | replace: ' ', '+' -%}
  {%- unless vts_font_loaded == s.font_family -%}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family={{ font_query }}:wght@300;400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all';this.onload=null;"
    >
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ font_query }}:wght@300;400;500;600;700;800&display=swap">
    </noscript>
    {%- assign vts_font_loaded = s.font_family -%}
  {%- endunless -%}
{%- endif -%}

<section
  id="VideoTextSplit-{{ uid }}"
  class="vts vts--{{ s.desktop_layout }}"
  style="
    --vts-section-height: {{ s.section_height }}vh;
    --vts-section-height-mobile: {{ s.section_height_mobile }}vh;
    --vts-mt: {{ s.margin_top }}px;
    --vts-mb: {{ s.margin_bottom }}px;
    --vts-pt: {{ s.padding_top }}px;
    --vts-pb: {{ s.padding_bottom }}px;
    --vts-max-width: {{ s.content_max_width }}px;
    --vts-gap: {{ s.column_gap }}px;
    --vts-radius: {{ s.section_radius }}px;

    --vts-video-bg: {{ s.video_bg_color }};
    --vts-video-fit: {{ s.video_fit }};
    --vts-video-width: {{ s.video_width }}%;
    --vts-video-radius: {{ s.video_radius }}px;
    --vts-video-col-pad: {{ s.video_column_padding }}px;
    --vts-video-overlay-color: {{ s.video_overlay_color }};
    --vts-video-overlay-opacity: {{ s.video_overlay_opacity }};

    --vts-text-bg: {{ s.text_bg_color }};
    --vts-text-pad-y: {{ s.text_padding_vertical }}px;
    --vts-text-pad-x: {{ s.text_padding_horizontal }}px;
    --vts-text-align: {{ s.text_align }};
    --vts-text-align-mobile: {{ s.text_align_mobile }};
    {% if s.font_family != 'theme' %}--vts-font: '{{ s.font_family }}', sans-serif;{% else %}--vts-font: inherit;{% endif %}

    --vts-sub-size: {{ s.subheading_size }}px;
    --vts-sub-size-mobile: {{ s.subheading_size_mobile }}px;
    --vts-sub-color: {{ s.subheading_color }};
    --vts-sub-weight: {{ s.subheading_weight }};
    --vts-sub-spacing: {{ s.subheading_letter_spacing }}px;
    --vts-sub-mb: {{ s.subheading_margin_bottom }}px;

    --vts-head-size: {{ s.heading_size }}px;
    --vts-head-size-mobile: {{ s.heading_size_mobile }}px;
    --vts-head-color: {{ s.heading_color }};
    --vts-head-weight: {{ s.heading_weight }};
    --vts-head-lh: {{ s.heading_line_height }};
    --vts-head-spacing: {{ s.heading_letter_spacing }}px;
    --vts-head-mb: {{ s.heading_margin_bottom }}px;

    --vts-body-size: {{ s.body_size }}px;
    --vts-body-size-mobile: {{ s.body_size_mobile }}px;
    --vts-body-color: {{ s.body_color }};
    --vts-body-weight: {{ s.body_weight }};
    --vts-body-lh: {{ s.body_line_height }};
    --vts-body-mb: {{ s.body_margin_bottom }}px;

    --vts-btn-bg: {{ s.button_bg_color }};
    --vts-btn-text: {{ s.button_text_color }};
    --vts-btn-bg-hover: {{ s.button_bg_hover }};
    --vts-btn-text-hover: {{ s.button_text_hover }};
    --vts-btn-border: {{ s.button_border_color }};
    --vts-btn-border-w: {{ s.button_border_width }}px;
    --vts-btn-radius: {{ s.button_radius }}px;
    --vts-btn-size: {{ s.button_font_size }}px;
    --vts-btn-weight: {{ s.button_font_weight }};
    --vts-btn-pad-y: {{ s.button_padding_vertical }}px;
    --vts-btn-pad-x: {{ s.button_padding_horizontal }}px;
    --vts-btn-spacing: {{ s.button_letter_spacing }}px;
  "
>
  <div class="vts__inner">

    {%- comment -%} ---------- VIDEO COLUMN ---------- {%- endcomment -%}
    <div class="vts__col vts__col--video">
      <div class="vts__video-media">
        {%- if s.video != blank -%}
          {%- comment -%} preload:'none' means no video bytes download until we ask {%- endcomment -%}
          {{ s.video
            | video_tag:
              image_size: '1100x',
              autoplay: false,
              loop: s.video_loop,
              muted: true,
              controls: s.video_controls,
              playsinline: true,
              preload: 'none',
              class: 'vts__video',
              data-vts-lazy: 'shopify'
          }}
        {%- elsif s.video_url != blank -%}
          <video
            class="vts__video"
            data-vts-lazy="external"
            data-vts-src="{{ s.video_url }}"
            data-vts-autoplay="{% if s.video_autoplay %}true{% else %}false{% endif %}"
            muted
            {% if s.video_loop %}loop{% endif %}
            {% if s.video_controls %}controls{% endif %}
            playsinline
            preload="none"
            {% if s.video_poster != blank %}poster="{{ s.video_poster | image_url: width: 1100 }}" {% endif %}
          ></video>
        {%- else -%}
          <div class="vts__video-placeholder">
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'vts__placeholder-svg' }}
            <span>Add a video in the theme editor</span>
          </div>
        {%- endif -%}

        {%- if s.video_overlay_opacity > 0 -%}
          <span class="vts__video-overlay" aria-hidden="true"></span>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- TEXT COLUMN ---------- {%- endcomment -%}
    <div
      class="vts__col vts__col--text"
      {% if s.text_bg_image != blank %}
        style="background-image: linear-gradient(rgba(0,0,0,{{ s.text_bg_overlay }}), rgba(0,0,0,{{ s.text_bg_overlay }})), url('{{ s.text_bg_image | image_url: width: 1400 }}'); background-size: cover; background-position: {{ s.text_bg_position }};"
      {% endif %}
    >
      <div class="vts__text-wrap">
        {%- if s.subheading != blank -%}
          <p class="vts__subheading">{{ s.subheading | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="vts__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}

        {%- if s.body != blank -%}
          <div class="vts__body">{{ s.body }}</div>
        {%- endif -%}

        {%- if s.button_label != blank and s.button_link != blank -%}
          <a href="{{ s.button_link }}" class="vts__btn">{{ s.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
  #VideoTextSplit-{{ uid }} {
    display: block;
    margin-top: var(--vts-mt);
    margin-bottom: var(--vts-mb);
    padding-top: var(--vts-pt);
    padding-bottom: var(--vts-pb);
    overflow: hidden;
    {% if s.section_radius > 0 %}border-radius: var(--vts-radius);{% endif %}
  }

  #VideoTextSplit-{{ uid }} .vts__inner {
    display: flex;
    width: 100%;
    {% if s.full_width == false %}
      max-width: var(--vts-max-width);
      margin-left: auto;
      margin-right: auto;
    {% endif %}
    gap: var(--vts-gap);
    /* Definite height so the video can actually be constrained by it */
    height: var(--vts-section-height);
    {% if s.desktop_layout == 'text-left' %}flex-direction: row-reverse;{% else %}flex-direction: row;{% endif %}
  }

  #VideoTextSplit-{{ uid }} .vts__col {
    flex: 1 1 50%;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---------- VIDEO COLUMN ---------- */
  #VideoTextSplit-{{ uid }} .vts__col--video {
    background: var(--vts-video-bg);
    padding: var(--vts-video-col-pad);
    overflow: hidden;
  }
  #VideoTextSplit-{{ uid }} .vts__video-media {
    position: relative;
    width: var(--vts-video-width);
    max-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--vts-video-radius);
    overflow: hidden;
  }
  #VideoTextSplit-{{ uid }} .vts__video,
  #VideoTextSplit-{{ uid }} .vts__col--video video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: var(--vts-video-fit);
    border-radius: var(--vts-video-radius);
  }
  #VideoTextSplit-{{ uid }} .vts__video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--vts-video-overlay-color);
    opacity: var(--vts-video-overlay-opacity);
    pointer-events: none;
    border-radius: var(--vts-video-radius);
  }
  #VideoTextSplit-{{ uid }} .vts__video-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: #f2f2f2;
    color: #777;
    font-size: 14px;
    border-radius: var(--vts-video-radius);
  }
  #VideoTextSplit-{{ uid }} .vts__placeholder-svg {
    width: 120px;
    height: auto;
    opacity: 0.4;
  }

  /* ---------- TEXT COLUMN ---------- */
  #VideoTextSplit-{{ uid }} .vts__col--text {
    background-color: var(--vts-text-bg);
    padding: var(--vts-text-pad-y) var(--vts-text-pad-x);
    font-family: var(--vts-font);
    text-align: var(--vts-text-align);
    overflow-y: auto;
    {% if s.text_vertical_align == 'top' %}align-items: flex-start;
    {% elsif s.text_vertical_align == 'bottom' %}align-items: flex-end;
    {% else %}align-items: center;{% endif %}
    {% if s.text_align == 'center' %}justify-content: center;
    {% elsif s.text_align == 'right' %}justify-content: flex-end;
    {% else %}justify-content: flex-start;{% endif %}
  }
  #VideoTextSplit-{{ uid }} .vts__text-wrap {
    width: 100%;
    max-width: {{ s.text_content_max_width }}px;
  }

  #VideoTextSplit-{{ uid }} .vts__subheading {
    font-family: var(--vts-font);
    font-size: var(--vts-sub-size);
    color: var(--vts-sub-color);
    font-weight: var(--vts-sub-weight);
    letter-spacing: var(--vts-sub-spacing);
    margin: 0 0 var(--vts-sub-mb) 0;
    {% if s.subheading_uppercase %}text-transform: uppercase;{% endif %}
  }
  #VideoTextSplit-{{ uid }} .vts__heading {
    font-family: var(--vts-font);
    font-size: var(--vts-head-size);
    color: var(--vts-head-color);
    font-weight: var(--vts-head-weight);
    line-height: var(--vts-head-lh);
    letter-spacing: var(--vts-head-spacing);
    margin: 0 0 var(--vts-head-mb) 0;
    {% if s.heading_uppercase %}text-transform: uppercase;{% endif %}
  }
  #VideoTextSplit-{{ uid }} .vts__body,
  #VideoTextSplit-{{ uid }} .vts__body p {
    font-family: var(--vts-font);
    font-size: var(--vts-body-size);
    color: var(--vts-body-color);
    font-weight: var(--vts-body-weight);
    line-height: var(--vts-body-lh);
    margin: 0 0 var(--vts-body-mb) 0;
  }

  #VideoTextSplit-{{ uid }} .vts__btn {
    display: inline-block;
    background: var(--vts-btn-bg);
    color: var(--vts-btn-text);
    border: var(--vts-btn-border-w) solid var(--vts-btn-border);
    border-radius: var(--vts-btn-radius);
    font-family: var(--vts-font);
    font-size: var(--vts-btn-size);
    font-weight: var(--vts-btn-weight);
    letter-spacing: var(--vts-btn-spacing);
    padding: var(--vts-btn-pad-y) var(--vts-btn-pad-x);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    {% if s.button_uppercase %}text-transform: uppercase;{% endif %}
    {% if s.button_full_width %}width: 100%; text-align: center;{% endif %}
  }
  #VideoTextSplit-{{ uid }} .vts__btn:hover {
    background: var(--vts-btn-bg-hover);
    color: var(--vts-btn-text-hover);
    border-color: var(--vts-btn-bg-hover);
  }

  /* ---------- MOBILE ---------- */
  @media screen and (max-width: 749px) {
    #VideoTextSplit-{{ uid }} .vts__inner {
      flex-direction: {% if s.mobile_layout == 'text-first' %}column-reverse{% else %}column{% endif %};
      /* On mobile the section grows to fit its stacked content */
      height: auto;
      min-height: var(--vts-section-height-mobile);
      gap: {{ s.column_gap_mobile }}px;
    }
    #VideoTextSplit-{{ uid }} .vts__col {
      flex: 0 0 auto;
      width: 100%;
      height: auto;
    }
    #VideoTextSplit-{{ uid }} .vts__col--video {
      padding: {{ s.video_column_padding_mobile }}px;
      height: {{ s.video_height_mobile }}vh;
    }
    #VideoTextSplit-{{ uid }} .vts__video-media {
      width: {{ s.video_width_mobile }}%;
      height: 100%;
    }
    #VideoTextSplit-{{ uid }} .vts__video,
    #VideoTextSplit-{{ uid }} .vts__col--video video {
      width: 100%;
      height: 100%;
      max-height: 100%;
    }
    #VideoTextSplit-{{ uid }} .vts__col--text {
      text-align: var(--vts-text-align-mobile);
      padding: {{ s.text_padding_vertical_mobile }}px {{ s.text_padding_horizontal_mobile }}px;
      overflow-y: visible;
      {% if s.text_align_mobile == 'center' %}justify-content: center;
      {% elsif s.text_align_mobile == 'right' %}justify-content: flex-end;
      {% else %}justify-content: flex-start;{% endif %}
    }
    #VideoTextSplit-{{ uid }} .vts__subheading { font-size: var(--vts-sub-size-mobile); }
    #VideoTextSplit-{{ uid }} .vts__heading { font-size: var(--vts-head-size-mobile); }
    #VideoTextSplit-{{ uid }} .vts__body,
    #VideoTextSplit-{{ uid }} .vts__body p { font-size: var(--vts-body-size-mobile); }

    #VideoTextSplit-{{ uid }} {
      margin-top: {{ s.margin_top_mobile }}px;
      margin-bottom: {{ s.margin_bottom_mobile }}px;
      padding-top: {{ s.padding_top_mobile }}px;
      padding-bottom: {{ s.padding_bottom_mobile }}px;
    }
  }
</style>

<script>
(function () {
  var section = document.getElementById('VideoTextSplit-{{ uid }}');
  if (!section) return;

  var video = section.querySelector('video[data-vts-lazy]');
  if (!video) return;

  var wantsAutoplay = {% if s.video_autoplay %}true{% else %}false{% endif %};
  var loaded = false;

  function loadVideo() {
    if (loaded) return;
    loaded = true;

    // External URL videos: inject the <source> only now, so no bytes
    // are requested until the section is actually approaching the viewport.
    if (video.getAttribute('data-vts-lazy') === 'external') {
      var url = video.getAttribute('data-vts-src');
      if (url && !video.querySelector('source')) {
        var source = document.createElement('source');
        source.src = url;
        source.type = 'video/mp4';
        video.appendChild(source);
      }
    }

    video.preload = 'auto';
    video.load();
  }

  function playIfWanted() {
    if (!wantsAutoplay) return;
    var p = video.play();
    if (p && typeof p.catch === 'function') { p.catch(function () {}); }
  }

  if ('IntersectionObserver' in window) {
    // Stage 1: start downloading slightly BEFORE the section is visible
    // so playback is ready by the time the user reaches it.
    var preloadObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          loadVideo();
          preloadObserver.disconnect();
        }
      });
    }, { rootMargin: '400px 0px' });
    preloadObserver.observe(section);

    // Stage 2: only play while actually on screen; pause when scrolled away
    // (saves CPU, bandwidth and mobile battery).
    var playObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          loadVideo();
          playIfWanted();
        } else if (!video.paused) {
          video.pause();
        }
      });
    }, { threshold: 0.25 });
    playObserver.observe(section);
  } else {
    // Older browsers: just load normally
    loadVideo();
    playIfWanted();
  }
})();
</script>

{% schema %}
{
  "name": "Video + Text Split",
  "tag": "section",
  "class": "section-video-text-split",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "desktop_layout", "label": "Desktop: video position",
      "options": [
        { "value": "video-left", "label": "Video left / Text right" },
        { "value": "text-left", "label": "Text left / Video right" }
      ],
      "default": "video-left"
    },
    {
      "type": "select", "id": "mobile_layout", "label": "Mobile: stacking order",
      "options": [
        { "value": "video-first", "label": "Video on top / Text below" },
        { "value": "text-first", "label": "Text on top / Video below" }
      ],
      "default": "video-first"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full screen width", "default": true },
    { "type": "range", "id": "content_max_width", "label": "Max content width (if not full width)", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1400 },
    { "type": "range", "id": "section_height", "label": "Desktop section height", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 70 },
    { "type": "range", "id": "section_height_mobile", "label": "Mobile min height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 0 },
    { "type": "range", "id": "column_gap", "label": "Desktop gap between columns", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "column_gap_mobile", "label": "Mobile gap between columns", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "section_radius", "label": "Section corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section Spacing — Desktop" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Section Spacing — Mobile" },
    { "type": "range", "id": "margin_top_mobile", "label": "Margin top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom_mobile", "label": "Margin bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video (upload to Shopify)" },
    { "type": "text", "id": "video_url", "label": "OR external MP4 URL", "info": "Only used if no video is uploaded above. Must be a direct .mp4 link." },
    { "type": "image_picker", "id": "video_poster", "label": "Poster image (for external URL)" },
    {
      "type": "select", "id": "video_fit", "label": "Video fit",
      "options": [
        { "value": "contain", "label": "Contain (show full video, no crop)" },
        { "value": "cover", "label": "Cover (fill column, may crop)" }
      ],
      "default": "contain",
      "info": "Use Contain for vertical videos so nothing gets cut off."
    },
    { "type": "range", "id": "video_width", "label": "Desktop video width", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video_width_mobile", "label": "Mobile video width", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video_height_mobile", "label": "Mobile video height", "min": 20, "max": 90, "step": 5, "unit": "vh", "default": 50 },
    { "type": "range", "id": "video_radius", "label": "Video corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "video_column_padding", "label": "Desktop video column padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "video_column_padding_mobile", "label": "Mobile video column padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "video_bg_color", "label": "Video column background", "default": "#f5f5f5" },
    { "type": "checkbox", "id": "video_autoplay", "label": "Autoplay (muted)", "default": true },
    { "type": "checkbox", "id": "video_loop", "label": "Loop video", "default": true },
    { "type": "checkbox", "id": "video_controls", "label": "Show video controls", "default": false },

    { "type": "header", "content": "Video Overlay" },
    { "type": "color", "id": "video_overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "video_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 0.9, "step": 0.1, "default": 0, "info": "Set to 0 for no overlay." },

    { "type": "header", "content": "Text Column — Background" },
    { "type": "color", "id": "text_bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "text_bg_image", "label": "Background image (optional)" },
    {
      "type": "select", "id": "text_bg_position", "label": "Background image position",
      "options": [
