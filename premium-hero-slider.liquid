{%- comment -%}
  Premium Hero Slider
  Custom coded for an elegant, responsive, and professional look.
{%- endcomment -%}

{%- liquid
  assign desk_height = section.settings.desktop_height
  assign desk_fit = section.settings.desktop_fit
  assign mob_height = section.settings.mobile_height
  assign lazy = section.settings.lazyload
-%}

<style>
  .premium-slider-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: transparent;
  }

  .premium-slider-track-{{ section.id }} {
    display: flex;
    width: 100%;
    height: {% if desk_height == 'natural' %}auto{% else %}{{ desk_height }}{% endif %};
  }

  .premium-slide-{{ section.id }} {
    min-width: 100%;
    flex: 0 0 100%;
    position: relative;
    display: flex;
    height: 100%;
    justify-content: center;
    align-items: center;
  }

  .premium-slide-link-{{ section.id }},
  .premium-slide-{{ section.id }} picture {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .premium-slide-{{ section.id }} img {
    width: 100%;
    height: 100%;
    display: block;
    {% if desk_height != 'natural' %}
      object-fit: {{ desk_fit }};
      object-position: center;
    {% else %}
      height: auto;
    {% endif %}
  }

  /* Navigation UI */
  .premium-slider-nav-{{ section.id }} {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 2;
    margin-top: {{ section.settings.nav_top_margin }}px;
  }

  .premium-dot-{{ section.id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    padding: 0;
  }

  .premium-dot-{{ section.id }}.active {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.2);
    box-shadow: 0 0 4px rgba(0,0,0,0.3);
  }

  .premium-arrow-{{ section.id }} {
    position: absolute;
    top: calc(50% + {{ section.settings.nav_top_margin }}px);
    transform: translateY(-50%);
    background: rgba(0,0,0,0.2);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .premium-arrow-{{ section.id }}:hover {
    background: rgba(0,0,0,0.6);
  }

  .premium-arrow-prev-{{ section.id }} { left: 20px; }
  .premium-arrow-next-{{ section.id }} { right: 20px; }

  .premium-arrow-{{ section.id }} svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 768px) {
    .premium-slider-track-{{ section.id }} {
      height: {% if mob_height == 'auto' %}auto{% else %}{{ mob_height }}{% endif %};
    }
    {% if mob_height != 'auto' %}
    .premium-slide-{{ section.id }} img {
      object-fit: cover;
      height: 100%;
    }
    {% else %}
    .premium-slide-{{ section.id }} img {
      height: auto;
    }
    {% endif %}
    .premium-arrow-{{ section.id }} {
      display: none;
    }
  }
</style>

<div class="premium-slider-{{ section.id }}" 
     data-autoplay="{{ section.settings.auto_slide }}" 
     data-speed="{{ section.settings.auto_speed | times: 1000 }}">
  
  <div class="premium-slider-track-{{ section.id }}">
    {% for block in section.blocks %}

      {%- comment -%}
        SPEED FIX: First slide always loads eager + high priority regardless of lazyload setting.
        Subsequent slides always lazy load. The old logic forced lazy on ALL slides when
        the lazyload checkbox was on, which hurt LCP on the first (visible) slide.
      {%- endcomment -%}
      {%- if forloop.first -%}
        {%- assign slide_loading = 'eager' -%}
        {%- assign slide_fetchpriority = 'high' -%}
      {%- else -%}
        {%- assign slide_loading = 'lazy' -%}
        {%- assign slide_fetchpriority = 'auto' -%}
      {%- endif -%}

      <div class="premium-slide-{{ section.id }}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="premium-slide-link-{{ section.id }}">
        {%- endif -%}

        <picture>
          {% if block.settings.image_mobile != blank %}
            <source media="(max-width: 768px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
          {% endif %}
          
          {% if block.settings.image_desktop != blank %}
            {%- comment -%}
              SPEED FIX: Reduced desktop width from 2000 to 1400 — saves ~40% file size
              with no visible quality loss on any screen. Added srcset so the browser
              automatically picks the most appropriate size for the device.
              Added fetchpriority="high" on first slide only so browser prioritises it.
            {%- endcomment -%}
            <img
              src="{{ block.settings.image_desktop | image_url: width: 1400 }}"
              srcset="
                {{ block.settings.image_desktop | image_url: width: 600 }} 600w,
                {{ block.settings.image_desktop | image_url: width: 900 }} 900w,
                {{ block.settings.image_desktop | image_url: width: 1400 }} 1400w
              "
              sizes="100vw"
              alt="{{ block.settings.image_desktop.alt | escape }}"
              loading="{{ slide_loading }}"
              fetchpriority="{{ slide_fetchpriority }}"
              width="{{ block.settings.image_desktop.width }}"
              height="{{ block.settings.image_desktop.height }}">
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </picture>

        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {% endfor %}
  </div>

  {% if section.settings.nav_visibility and section.blocks.size > 1 %}
    {% if section.settings.nav_style == 'arrows' or section.settings.nav_style == 'both' %}
      <button class="premium-arrow-{{ section.id }} premium-arrow-prev-{{ section.id }}" aria-label="Previous Slide">
        <svg viewBox="0 0 24 24"><path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"/></svg>
      </button>
      <button class="premium-arrow-{{ section.id }} premium-arrow-next-{{ section.id }}" aria-label="Next Slide">
        <svg viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/></svg>
      </button>
    {% endif %}

    {% if section.settings.nav_style == 'dots' or section.settings.nav_style == 'both' %}
      <div class="premium-slider-nav-{{ section.id }}">
        {% for block in section.blocks %}
          <button class="premium-dot-{{ section.id }} {% if forloop.first %}active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const slider = document.querySelector('.premium-slider-{{ section.id }}');
    if (!slider) return;

    const track = slider.querySelector('.premium-slider-track-{{ section.id }}');
    const originalSlides = Array.from(slider.querySelectorAll('.premium-slide-{{ section.id }}'));
    const dots = slider.querySelectorAll('.premium-dot-{{ section.id }}');
    const prevBtn = slider.querySelector('.premium-arrow-prev-{{ section.id }}');
    const nextBtn = slider.querySelector('.premium-arrow-next-{{ section.id }}');
    
    let currentIndex = 0;
    const totalOriginal = originalSlides.length;
    let autoPlayTimer;
    let isTransitioning = false;
    
    const isAutoPlay = slider.getAttribute('data-autoplay') === 'true';
    const speed = parseInt(slider.getAttribute('data-speed'), 10);

    // Infinite Slider Setup
    if (totalOriginal > 1) {
      const firstClone = originalSlides[0].cloneNode(true);
      const lastClone = originalSlides[totalOriginal - 1].cloneNode(true);

      track.appendChild(firstClone);
      track.insertBefore(lastClone, originalSlides[0]);

      currentIndex = 1;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      function updateSlider(index, smooth = true) {
        currentIndex = index;
        if (smooth) {
          track.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
        } else {
          track.style.transition = 'none';
        }
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        let dotIndex = currentIndex - 1;
        if (dotIndex === totalOriginal) dotIndex = 0; 
        if (dotIndex === -1) dotIndex = totalOriginal - 1; 
        
        dots.forEach(dot => dot.classList.remove('active'));
        if(dots[dotIndex]) dots[dotIndex].classList.add('active');
      }

      track.addEventListener('transitionend', () => {
        isTransitioning = false;
        if (currentIndex === 0) {
          updateSlider(totalOriginal, false);
        } else if (currentIndex === totalOriginal + 1) {
          updateSlider(1, false);
        }
      });

      function nextSlide() {
        if (isTransitioning) return;
        isTransitioning = true;
        updateSlider(currentIndex + 1);
      }

      function prevSlide() {
        if (isTransitioning) return;
        isTransitioning = true;
        updateSlider(currentIndex - 1);
      }

      if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetAutoPlay(); });
      if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetAutoPlay(); });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          if (isTransitioning) return;
          updateSlider(index + 1);
          resetAutoPlay();
        });
      });

      let startX = 0;
      let endX = 0;

      slider.addEventListener('touchstart', e => {
        startX = e.changedTouches[0].screenX;
      }, {passive: true});

      slider.addEventListener('touchend', e => {
        endX = e.changedTouches[0].screenX;
        if (startX - endX > 50) nextSlide();
        if (endX - startX > 50) prevSlide();
        resetAutoPlay();
      }, {passive: true});

      function startAutoPlay() {
        if (isAutoPlay && totalOriginal > 1) {
          autoPlayTimer = setInterval(() => {
            if (!isTransitioning) {
              isTransitioning = true;
              updateSlider(currentIndex + 1);
            }
          }, speed);
        }
      }

      function resetAutoPlay() {
        clearInterval(autoPlayTimer);
        startAutoPlay();
      }

      slider.addEventListener('mouseenter', () => clearInterval(autoPlayTimer));
      slider.addEventListener('mouseleave', startAutoPlay);

      startAutoPlay();
      
    } else {
      track.style.transform = `translateX(0%)`;
    }
  });
</script>

{% schema %}
{
  "name": "Premium Hero Slider",
  "settings": [
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "options": [
        { "value": "natural", "label": "Natural (Adapts to image)" },
        { "value": "450px", "label": "450px" },
        { "value": "550px", "label": "550px" },
        { "value": "650px", "label": "650px" },
        { "value": "750px", "label": "750px" },
        { "value": "100vh", "label": "Full Screen" }
      ],
      "default": "650px"
    },
    {
      "type": "select",
      "id": "desktop_fit",
      "label": "Image Fit (If using fixed height)",
      "info": "Choose how the image behaves if the screen size doesn't match the image size perfectly.",
      "options": [
        { "value": "cover", "label": "Fill Screen (No gaps, edge-to-edge)" },
        { "value": "contain", "label": "Show Whole Image (May leave gaps on sides)" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "options": [
        { "value": "auto", "label": "Auto (Adapts to image)" },
        { "value": "250px", "label": "250px" },
        { "value": "300px", "label": "300px" },
        { "value": "400px", "label": "400px" },
        { "value": "500px", "label": "500px" },
        { "value": "100vh", "label": "Full Screen" }
      ],
      "default": "400px"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "nav_visibility",
      "label": "Show Navigation",
      "default": true
    },
    {
      "type": "select",
      "id": "nav_style",
      "label": "Navigation Style",
      "options": [
        { "value": "dots", "label": "Dots Only" },
        { "value": "arrows", "label": "Arrows Only" },
        { "value": "both", "label": "Dots & Arrows" }
      ],
      "default": "both"
    },
    {
      "type": "range",
      "id": "nav_top_margin",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Navigation Top/Bottom Margin Offset",
      "default": 0
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Enable Auto Slide",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "sec",
      "label": "Change slide every",
      "default": 5
    },
    {
      "type": "header",
      "content": "Performance"
    },
    {
      "type": "checkbox",
      "id": "lazyload",
      "label": "Enable Lazy Loading",
      "info": "This setting now only affects slides 2 and onwards. The first slide always loads eagerly for best LCP score.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image",
          "info": "Recommended width: 1400px"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image",
          "info": "Recommended width: 800px. If left blank, desktop image will be used."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
